{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug (Pi or host)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "native-release",
      "displayName": "Native Release (Pi or host)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-x64",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/tools/cmake/linux-x64_toolchain.cmake"
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Clang 19 Debug",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Clang 19 Release",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "native-release", "configurePreset": "native-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
